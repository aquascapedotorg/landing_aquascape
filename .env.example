# ==============================================================================
# AQUASCAPE LANDING - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Salin file ini menjadi .env dan sesuaikan nilainya:
# cp .env.example .env

# Sumber data nama ikan: 'local' (dari public/fish-names.json) atau 'supabase'
# Nilai default: local
VITE_FISH_DATA_SOURCE=local

# ------------------------------------------------------------------------------
# KONFIGURASI SUPABASE (Hanya aktif jika VITE_FISH_DATA_SOURCE=supabase)
# ------------------------------------------------------------------------------
# URL project Supabase Anda (bisa dilihat di Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anonymous Key Supabase (anon public)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Nama tabel Supabase yang menyimpan daftar ikan/nama
# Default: communal_fishes
VITE_SUPABASE_FISH_TABLE=communal_fishes

# STRUKTUR TABEL SUPABASE YANG DIDUKUNG:
# - name (text, wajib): Nama ikan yang akan ditampilkan pada nametag
# - species (text, opsional): Jenis ikan. Jika kosong / tidak ada, otomatis DEFAULT ke 'neonTetra'
#   Pilihan jenis ikan yang didukung:
#   - mascot        (Origami Aquascape)
#   - neonTetra     (Default: Ikan Neon Tetra bercahaya)
#   - cherryShrimp  (Udang Hias Cherry)
#   - angelfish     (Ikan Layang / Manfish)
#   - rasbora       (Harlequin Rasbora)
#   - guppy         (Fancy Guppy)
#   - shark         (Hiu Samudra)
#   - whale         (Paus Raksasa)
#   - dolphin       (Lumba-lumba)
#   - mantaRay      (Ikan Pari)
#   - pufferfish    (Ikan Buntal)
#   - orca          (Paus Pembunuh Orca)
#   - turtle        (Penyu Laut)
# - created_at (timestamp, opsional): Digunakan untuk mengurutkan ikan terbaru
